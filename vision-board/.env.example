# Copy these into Vercel: Project Settings -> Environment Variables.
# Never commit a real .env file -- this repo's .gitignore already excludes it.

# Airtable Personal Access Token. Create one at https://airtable.com/create/tokens
# Scopes:      data.records:read, data.records:write, schema.bases:read
# Access to:   "LSFG Coaching" base AND "LSFG Video Pipeline" base
AIRTABLE_PAT=

# The password that protects the whole board. Change it any time by just
# updating this value in Vercel -- no code changes needed.
VISION_BOARD_PASSWORD=

# Random signing key for session cookies. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this instantly logs everyone out (forces a fresh sign-in).
SESSION_SECRET=
