# Everything here is OPTIONAL. The app runs with no .env at all (demo mode, local single-user, mailto drafts).
# Copy to .env (which is git-ignored) only for the features you want. Never commit real values.

# --- Who can sign in -------------------------------------------------------------------------
# "local" (no login, one person on their own machine) or "accounts" (sign-in, every record owned by one consultant).
# A production build with this unset runs as "accounts". Running open in production needs AUTH_MODE=local.
# AUTH_MODE=accounts
# After the first owner exists, sign-up is closed unless you set this to "true".
# ALLOW_SIGNUP=false
# Set to "false" only for a plain-http local production build (browsers will not keep a Secure cookie over http).
# COOKIE_SECURE=true

# --- Email sent from the app (otherwise the Share dialog opens a mailto: draft) -----------------
# SMTP_HOST=smtp.yourprovider.example
# SMTP_PORT=587                      # 465 means implicit TLS
# SMTP_FROM="Reviews <reviews@yourdomain.example>"
# SMTP_USER=
# SMTP_PASS=                          # both or neither; STARTTLS is required for any non-local host
# SMTP_SECURE=false

# --- PDF files made on the server (otherwise use the browser's Save as PDF) ----------------------
# Path to a Chromium or Chrome binary, or run: npx playwright-core install chromium
# PDF_CHROMIUM_PATH=/usr/bin/chromium
# Where the app can reach itself (defaults to http://127.0.0.1:$PORT). Never taken from a request header.
# INTERNAL_URL=http://127.0.0.1:3000

# --- Claude (optional; the rule-based engine is the default and needs nothing) ----------------------
# With a key set, Settings offers "Claude" as the analysis engine. The key stays on the server.
# ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Live analysis runs often: a cheaper model is your call.
# ANTHROPIC_MODEL=claude-opus-5-5
# Only for pointing the app at a proxy or a test stand-in. Leave unset to use Anthropic.
# ANTHROPIC_BASE_URL=

# --- Live meetings (optional) ---------------------------------------------------------------------
# A Recall.ai key lets "Connect meeting" send a note-taker bot to a Zoom / Meet / Teams call.
# RECALL_API_KEY=
# RECALL_REGION=us-west-2            # us-west-2, us-east-1, eu-central-1 or ap-northeast-1
# RECALL_TRANSCRIPT=meeting_captions # default is Recall's own transcription
# The app's public https address, so the bot knows where to send lines (Vercel sets this for you).
# PUBLIC_URL=https://cockpit.example.com

# --- A server on the public web --------------------------------------------------------------------
# Required to create an account when set. Use it so a stranger cannot claim the first (owner) account.
# SIGNUP_CODE=

# --- Database (defaults to a local SQLite file) --------------------------------------------------
# DATABASE_URL=file:./prisma/dev.db
# A postgres:// URL also works (hosting): see "Hosting it" in the README.
