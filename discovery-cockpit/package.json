{
  "name": "discovery-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted discovery-call cockpit for independent consultants (starter slice)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma": "node scripts/prisma.mjs",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "setup": "npm run db:migrate && npm run db:seed",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
