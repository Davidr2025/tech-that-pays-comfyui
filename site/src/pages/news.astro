---
import Base from "../layouts/Base.astro";
import NewsCard from "../components/NewsCard.astro";
import NewsModal from "../components/NewsModal.astro";
import AdSlot from "../components/AdSlot.astro";
import config from "../../site.config.mjs";
import news from "../data/news.json";
import { isPublishable } from "../lib/news-data.mjs";

// Only ever show items that pass isPublishable (rewritten into our own
// original wording, long enough, and carrying real attribution) — a
// freshly-fetched item that hasn't gone through that pass yet, or one the
// rewrite pass got wrong, stays hidden rather than showing the source's
// verbatim text or a too-thin/unattributed rewrite.
const items = news.items.filter(isPublishable);
const mid = Math.ceil(items.length / 2);
const firstHalf = items.slice(0, mid);
const secondHalf = items.slice(mid);
---
<Base title="Top News" description={`The latest ${config.city} headlines, curated from local sources with links to the original coverage.`} current="news">
  <section class="section container">
    <div class="section-head">
      <h2>Mississauga News</h2>
      <span class="sub">Excerpts only: every story links to and credits its original source</span>
    </div>

    <AdSlot id="news-top" variant="banner" />

    {items.length ? (
      <>
        <div class="grid">{firstHalf.map((item) => <NewsCard item={item} />)}</div>
        {secondHalf.length > 0 && (
          <>
            <AdSlot id="news-mid" variant="banner" />
            <div class="grid">{secondHalf.map((item) => <NewsCard item={item} />)}</div>
          </>
        )}
      </>
    ) : (
      <p class="empty">Headlines refresh automatically every 6 hours. The first update lands shortly.</p>
    )}
    <p style="font-size:.85rem;color:var(--muted);margin-top:1.5rem">
      Sources: {config.news.sources.map((s, i) => (
        <>{i > 0 && " · "}<a href={s.homepage} target="_blank" rel="noopener">{s.name}</a></>
      ))}
    </p>
  </section>

  <NewsModal />
</Base>
