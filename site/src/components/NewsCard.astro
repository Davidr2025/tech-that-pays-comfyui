---
import { effectiveDate } from "../lib/news-data.mjs";
const { item } = Astro.props;
// Shows when we published this on our site (falls back to the source's
// own date for older items that predate that field) — see effectiveDate.
const dateValue = effectiveDate(item);
const date = dateValue
  ? new Date(dateValue).toLocaleDateString("en-CA", { month: "short", day: "numeric", timeZone: "America/Toronto" })
  : "";
---
<article class="card news-card" role="button" tabindex="0" data-news-trigger data-item={JSON.stringify(item)}>
  <h3>{item.title}</h3>
  <div class="meta">
    <a
      class="source-badge"
      href={item.sourceUrl}
      target="_blank"
      rel="noopener"
      title={`Source: ${item.source}`}
      onclick="event.stopPropagation()"
    >{item.source}</a>
    {date && <span>{date}</span>}
  </div>
</article>
